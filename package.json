{
  "name": "bebidas-atomic",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:holding": "cd jbm-master-app && npm ci --silent && npm run build:holding && cd .. && rm -rf public/holding && cp -r jbm-master-app/dist public/holding && vite build",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy-vercel.sh",
    "deploy:bebidas": "bash scripts/deploy-vercel.sh bebidas",
    "deploy:jbm": "bash scripts/deploy-vercel.sh jbm",
    "audit:live": "node scripts/audit-live.mjs",
    "test:procurement": "node scripts/procurement.test.mjs",
    "test:legacy": "node scripts/legacyAccess.test.mjs",
    "test:payroll": "node scripts/payroll.test.mjs",
    "test:pos": "node scripts/posFloor.test.mjs && node scripts/posEngine.test.mjs",
    "test:security": "node scripts/securityModel.test.mjs",
    "test:migration": "node scripts/validateMigration.mjs",
    "test:migration:pg": "node scripts/migrationLegacy.pg.test.mjs",
    "check:bar-pricing": "node scripts/checkBarPricingDuplicates.mjs",
    "test:employees": "node scripts/employeeAccess.test.mjs",
    "test:pos:pg": "node scripts/posFloor.pg.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vercel": "^59.1.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "pg": "^8.23.0",
    "vite": "^5.0.0"
  }
}
