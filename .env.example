# Copy to .env.local — never commit secrets

# Drinks project (ojirgkqtqvugqktyuhem) — NOT the Holding project
VITE_SUPABASE_URL=https://ojirgkqtqvugqktyuhem.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Vercel → Settings → Environment Variables (Production + Preview)
# MUST be service_role from ojirgkqtqvugqktyuhem — wrong project breaks all /api/* routes
SUPABASE_SERVICE_ROLE_KEY=your_drinks_service_role_key
GEMINI_API_KEY=your_gemini_key

# Optional — cron sync + internal API calls
CRON_SECRET=random_secret_for_vercel_cron
HOLDING_SYNC_SECRET=random_secret_for_holding_sync
INTERNAL_API_SECRET=random_secret_for_service_calls
FIX_ATOMIC_SECRET=random_secret_for_data_fix_endpoint

# Email automation (Resend) — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=JBM Drinks <billing@yourdomain.com>
REPORT_EMAIL_RECIPIENTS=admin@example.com,finance@example.com
PORTAL_URL=https://bebidas-control.vercel.app

# Holding Supabase (fxsakrshmldmkdmbevna) — separate from Drinks
HOLDING_SERVICE_ROLE_KEY=your_holding_service_role_key
HOLDING_SUPABASE_URL=https://fxsakrshmldmkdmbevna.supabase.co
