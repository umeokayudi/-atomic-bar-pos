# Copy to .env.local — never commit secrets
# The app does not fill these in. A missing URL is an error, not another project.
# Staging must be its own Supabase project. Do not point staging at production.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_BAR_ID=

# Server only. Never a VITE_ variable. Must be the service_role key of VITE_SUPABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GEMINI_API_KEY=your_gemini_key

# Optional — cron sync + internal API calls
CRON_SECRET=random_secret_for_vercel_cron
HOLDING_SYNC_SECRET=random_secret_for_holding_sync
INTERNAL_API_SECRET=random_secret_for_service_calls
FIX_ATOMIC_SECRET=random_secret_for_data_fix_endpoint

# Email automation (Resend) — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=JBM Drinks <billing@yourdomain.com>
REPORT_EMAIL_RECIPIENTS=admin@example.com,finance@example.com
PORTAL_URL=https://bebidas-control.vercel.app

# Holding Supabase — separate from the bar project. Required for holding sync. Not a default.
HOLDING_SERVICE_ROLE_KEY=your_holding_service_role_key
HOLDING_SUPABASE_URL=https://YOUR_HOLDING_REF.supabase.co
